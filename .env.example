# ────────────────────────────────────────────────────────────────────────────
# Personal Health Copilot — environment variables
# This file contains DEMO values only. Never commit real credentials.
# ────────────────────────────────────────────────────────────────────────────

# Local SQLite database used for development / hackathon demos.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to hash session tokens. CHANGE THIS for any real deployment.
SESSION_SECRET="dev-only-change-me-personal-health-copilot"

# Where uploaded medical documents are stored (outside the web root).
UPLOAD_DIR="./data/uploads"

# Maximum accepted upload size in megabytes (server limit) and the same number
# exposed to the browser so the dropzone can reject oversized files early.
MAX_UPLOAD_MB="10"
NEXT_PUBLIC_MAX_UPLOAD_MB="10"

# ── AI provider ─────────────────────────────────────────────────────────────
# Leave empty to use the built-in MockHealthAIProvider (fully working, no keys).
# Supported values once a key is present: "mock" | "openai" | "gemini" | "azure-openai"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# ── OCR provider ────────────────────────────────────────────────────────────
# Local Tesseract OCR is the default; documents are not sent to an OCR vendor.
# Set OCR_PROVIDER=mock only for synthetic demo samples; hosted providers are not wired.
OCR_PROVIDER="tesseract"
OCR_LANGUAGES="eng"
# Keep the client-side demo controls in sync; use "mock" only in a disposable demo environment.
NEXT_PUBLIC_OCR_PROVIDER="tesseract"
# OCR resource limits: PDFs are capped at 20 pages and images at 20 megapixels.
# To enable bilingual local OCR, set OCR_LANGUAGES="eng+hin" (both models are bundled).

# ── Drug interaction provider ───────────────────────────────────────────────
# "demo" uses the seeded local dataset. "rxnav" calls the public NLM API below.
INTERACTION_PROVIDER="demo"
RXNAV_BASE_URL="https://rxnav.nlm.nih.gov/REST"

# ── ABDM / ABHA ─────────────────────────────────────────────────────────────
# DEMO ONLY. Official ABHA authentication requires approved ABDM integration
# (sandbox client id/secret + consent artefacts). No requests are made in demo.
ABDM_MODE="demo"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BASE_URL=""

# ── Voice assistant ─────────────────────────────────────────────────────────
# Speech-to-text and text-to-speech are provider choices, never hard-coded.
#   "browser" → Web Speech API / MediaRecorder + SpeechSynthesis (default; no key)
#   "openai"  → server-side OpenAI-compatible endpoints (key required)
#   "none"    → text-only; the UI reports that voice is unavailable
# If a server provider is selected without a key, the app falls back to
# "browser" and reports the limitation in the UI.
VOICE_STT_PROVIDER="browser"
VOICE_TTS_PROVIDER="browser"
# Speech-only key. Falls back to OPENAI_API_KEY when empty.
VOICE_OPENAI_API_KEY=""
# Falls back to OPENAI_BASE_URL / https://api.openai.com/v1 when empty.
VOICE_OPENAI_BASE_URL=""
VOICE_STT_MODEL="whisper-1"
VOICE_TTS_MODEL="tts-1"
# Voice used for spoken answers. VOICE_TTS_VOICE overrides both languages; leave
# it empty to use "alloy" for English and "shimmer" for Hindi, so the two
# languages never share a voice by accident.
VOICE_TTS_VOICE=""
VOICE_TTS_VOICE_EN=""
VOICE_TTS_VOICE_HI=""

# Limits enforced by both the browser hook and the server routes.
VOICE_MAX_RECORDING_SECONDS="45"
VOICE_MAX_AUDIO_MB="8"
VOICE_MAX_SPEAK_CHARS="1500"
VOICE_MAX_QUESTION_CHARS="400"

# ── Emergency help & care calendar ───────────────────────────────────────────
# Emergency number shown on the site and used for the confirmed tel: link.
# India's unified emergency number is 112. Digits only, 2–6 characters.
EMERGENCY_NUMBER="112"

# Phone verification for emergency contacts. Verification is ONLY possible
# through a server-side provider. "none" (the default) means verification is
# unavailable and no contact can be shown as verified.
# Supported: "twilio-verify". Credentials stay on the server — never prefix them
# with NEXT_PUBLIC_.
OTP_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
